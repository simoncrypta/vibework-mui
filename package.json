{
  "name": "vibework",
  "version": "0.0.0",
  "private": true,
  "description": "RedwoodSDK + Vite+ starter (MUI variant)",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "dev:init": "node scripts/dev-init.mjs",
    "build": "vp build",
    "preview": "vp preview",
    "worker:run": "rw-scripts worker-run",
    "clean": "vp run clean:vite",
    "clean:vite": "rm -rf ./node_modules/.vite",
    "release": "rw-scripts ensure-deploy-env && vp run clean && vp run build && wrangler deploy",
    "generate": "rw-scripts ensure-env && wrangler types --include-runtime false",
    "types": "tsc",
    "storybook": "storybook dev -p 6006",
    "storybook-build": "storybook build",
    "build:starter": "node scripts/build-starter.mjs",
    "generate:mui-stories": "node scripts/generate-mui-stories.mjs",
    "prepare": "vp config"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/material-icons": "^5.2.7",
    "@fontsource/roboto": "^5.2.10",
    "@mui/lab": "9.0.0-beta.6",
    "@mui/material": "^9.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-server-dom-webpack": "19.2.7",
    "rwsdk": "^1.5.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.43.0",
    "@cloudflare/workers-types": "^4.20260426.1",
    "@mui/icons-material": "^9.2.0",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-mcp": "0.6.0",
    "@storybook/addon-themes": "^10.4.6",
    "@storybook/addon-vitest": "^10.4.6",
    "@storybook/react": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "^4.1.9",
    "playwright": "^1.61.1",
    "storybook": "^10.4.6",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.107.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "warn"
    }
  }
}
